<!-- Import this props file from projects that define [MapException] interfaces. -->
<Project>
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)CrossCutting.Core.Aspects.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all"
                      SetTargetFramework="TargetFramework=netstandard2.0"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishAot;PublishTrimmed;PublishReadyToRun;PublishSingleFile" />
  </ItemGroup>
</Project>
